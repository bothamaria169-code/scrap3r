# Bright Data API token — https://brightdata.com dashboard > Account settings > API tokens
BRIGHTDATA_API_TOKEN=

# Optional: override the Zoominfo dataset id (defaults to gd_m0ci4a4ivx3j5l6nx)
# BRIGHTDATA_DATASET_ID=

# --- Web app ---
APP_URL=http://localhost/scrap3r/public
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scrap3r
DB_USER=root
DB_PASS=

# --- SMTP (set these in the app's Settings page, or here as defaults) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Timezone for send windows, booking slots and timestamps
APP_TZ=Africa/Johannesburg

# --- Database engine ---
# mysql (default, local XAMPP) or sqlite (hosted: a single file, no server needed)
# DB_DRIVER=sqlite
# DB_PATH=storage/database.sqlite
