# Copy to .env on the server and fill in the password / install key.
APP_URL=https://scrap3r.swiftfusion.co.za
APP_ENV=production
APP_TZ=Africa/Johannesburg

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swiftfusionco_scrap3r
DB_USER=swiftfusionco_scrap3r
DB_PASS=CHANGE_ME

# Any long random value. Open install.php?key=<this value> to create the first admin.
INSTALL_KEY=CHANGE_ME

BRIGHTDATA_API_TOKEN=
