# The web root should be public/ (Plesk: Hosting & DNS -> Document root).
# If a server serves this project folder instead, every request is routed
# into public/, so the app still works and nothing else here is reachable:
# .env, the database, code and docs all resolve inside public/ and 404.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Already inside public/: leave it alone (also stops a rewrite loop).
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# No mod_rewrite: fail closed rather than expose the project.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
